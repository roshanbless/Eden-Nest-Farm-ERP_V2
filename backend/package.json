{
  "name": "eden-nest-backend",
  "version": "1.0.0",
  "description": "NestJS backend for Eden Nest Farm ERP",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
